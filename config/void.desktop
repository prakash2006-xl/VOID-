[Desktop Entry]
Type=Application
Name=VOID AI Assistant
GenericName=AI Desktop Assistant
Comment=Launch VOID Autonomous AI Desktop Assistant
Exec=/run/media/prakash/TR_39/VOID/scripts/run_void.sh
Path=/run/media/prakash/TR_39/VOID
Icon=system-run
Terminal=false
Categories=Utility;System;AudioVideo;
StartupNotify=true
Actions=Stop;Configure;

[Desktop Action Stop]
Name=Stop VOID & Clear RAM
Comment=Stop VOID, deactivate neural models, and reclaim RAM
Exec=/run/media/prakash/TR_39/VOID/scripts/stop_void.sh

[Desktop Action Configure]
Name=Configure VOID Models
Comment=Configure AI models and keys in terminal
Exec=/run/media/prakash/TR_39/VOID/terminalsetuprun
